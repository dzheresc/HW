# --- Vivado / openXC7 build outputs (regenerate with build.tcl / make) ---
build/
chipdb/
.Xil/
.cache/
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
xsim.dir/
*.dcp
*.bit
*.bin
*.mcs
*.prm
*.ltx
*.frames
*.fasm
*.rpt

# Generated IP: keep only the .xci, Vivado regenerates the rest from it
**/ip/*/*
!**/ip/*/*.xci

# Logs, journals, webtalk, tool scratch
*.log
*.jou
*.out
*.pb
*.os
*.str
usage_statistics_webtalk.*
webtalk*
vivado*.backup.*

# Host tool binaries
*.exe
*.o
*.obj

# Flash backups and dumps: never commit
*flash_backup*
*backup*.bin
pattern*.bin
gap*.bin

# More local leftovers
vendor/
build_*/
.tmpCRC/
clockInfo.txt
ila_*.csv

# KU5P projects create all their IP with gen_ip.tcl: nothing under ip/ is source
/ku5p_ddr/ip/
/ku5p_pcie/ip/
/ku5pf_ddr/ip/
# Vivado congestion reports from place/route
cong/
# Project-mode folders made by create_project.tcl / proj_build.tcl
*.xpr
/arty_blink/vivado/
/blink/led_blinker/
/eth_recv/eth_recv/
/udp/udp_sender/
/udp_2/udp_sender/
